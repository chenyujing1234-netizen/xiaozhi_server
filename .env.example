# 复制为 .env 或直接 export 这些环境变量

# 阿里百炼 DashScope API Key（ASR/LLM/TTS 共用）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 对外地址：设备(ESP32)会用它连回服务端，务必填你服务器的局域网/公网 IP
PUBLIC_HOST=192.168.1.100

# 设备传输方式：mqtt（设备出厂默认）或 websocket
TRANSPORT=mqtt

# 端口
OTA_PORT=8002
MQTT_PORT=1883
UDP_PORT=8001
WS_PORT=8000

# 模型选择（可按需修改）
LLM_MODEL=qwen-plus
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun_v2

# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO

# 连续多少帧超过阈值才视为有效语音（每帧 60ms，默认 3）
SPEECH_FRAMES_REQUIRED=3

# 说完一句话后，静音多少秒即认为 ASR 结束并送 LLM（默认 2 秒）
UTTERANCE_END_SILENCE_SEC=2
# 整轮聆听无任何有效语音时，多少秒后 goodbye 退出（默认 15 秒）
SILENCE_TIMEOUT_SEC=15
# 连续多少次「有语音但 ASR 无文本」后 goodbye 退出（默认 3 次）
EMPTY_UTTERANCE_LIMIT=3

# 流式 LLM 分句：累计多少字且遇到逗号/句号时先送 TTS（默认 10）
TTS_SPLIT_MIN_CHARS=10

# 是否保存上行音频为 wav（调试用）：1 开启
SAVE_AUDIO=0

# 是否在日志打印上行音频 RMS 能量（约每秒 1 条，调 VAD 阈值时用）：1 开启
LOG_AUDIO_RMS=0

# 查看完整链路日志（ASR→LLM→TTS）：
#   tail -f /tmp/xiaozhi_server.log | grep pipeline
