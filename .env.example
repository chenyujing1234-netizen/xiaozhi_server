# 复制为 .env 或直接 export 这些环境变量

# 阿里百炼 DashScope API Key（ASR/LLM/TTS 共用）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 对外地址：设备(ESP32)会用它连回服务端，务必填你服务器的局域网/公网 IP
PUBLIC_HOST=192.168.1.100

# 设备传输方式：mqtt（设备出厂默认）或 websocket
TRANSPORT=mqtt

# 端口
OTA_PORT=8002
MQTT_PORT=1883
UDP_PORT=8001
WS_PORT=8000

# SpeakPal 用户 Web 页（HTTPS + WSS，微信内录音必需）
# 方式 A（推荐）：nginx + Let's Encrypt 正式域名，运行 sudo tools/setup_linkpal_ssl.sh
ENGLISH_WEB_DOMAIN=linkpal.cloud
HTTPS_ENABLED=0
# 方式 B（IP 直连）：nginx 在 8443 统一代理页面+WSS，运行 sudo tools/setup_speakpal_8443.sh
# HTTPS_ENABLED=0
# 用户入口: https://<PUBLIC_HOST>:8443/english/

# 模型选择（可按需修改）
LLM_MODEL=qwen-plus
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun_v2

# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO

# 连续多少帧超过阈值才视为有效语音（每帧 60ms，默认 3）
SPEECH_FRAMES_REQUIRED=3

# 说完一句话后，静音多少秒即认为 ASR 结束并送 LLM（默认 2 秒）
UTTERANCE_END_SILENCE_SEC=2
# 整轮聆听无任何有效语音时，多少秒后 goodbye 退出（默认 15 秒）
SILENCE_TIMEOUT_SEC=15
# 连续多少次「有语音但 ASR 无文本」后 goodbye 退出（默认 3 次）
EMPTY_UTTERANCE_LIMIT=3

# 流式 LLM 分句：累计多少字且遇到逗号/句号时先送 TTS（默认 10）
TTS_SPLIT_MIN_CHARS=10

# 是否保存上行音频为 wav（调试用）：1 开启
SAVE_AUDIO=0

# 是否在日志打印上行音频 RMS 能量（约每秒 1 条，调 VAD 阈值时用）：1 开启
LOG_AUDIO_RMS=0

# 查看完整链路日志（ASR→LLM→TTS）：
#   tail -f /tmp/xiaozhi_server.log | grep pipeline

# ---- 英语口语练习智能体（独立端口，不影响默认小智）----
ENGLISH_ENABLED=1
ENGLISH_MQTT_PORT=1884
ENGLISH_UDP_PORT=8003
# 设备 OTA 改为: http://<PUBLIC_HOST>:8002/xiaozhi/ota/english/
ENGLISH_OMNI_MODEL=qwen3.5-omni-plus-realtime
ENGLISH_OMNI_VOICE=Ethan

# ---- 英语口语练习智能体（独立端口，不影响默认小智）----
# 设为 0 可关闭英语通道
ENGLISH_ENABLED=1
ENGLISH_MQTT_PORT=1884
ENGLISH_UDP_PORT=8003
# 百炼 S2S 多模态：音频进 → 音频出；instructions 含「中文纠错 + 正确英文重读」协议
ENGLISH_OMNI_MODEL=qwen3.5-omni-plus-realtime
ENGLISH_OMNI_VOICE=Ethan
# 也可通过 ENGLISH_OMNI_INSTRUCTIONS 覆盖整段导师提示词
# 设备 OTA 改为: http://<PUBLIC_HOST>:8002/xiaozhi/ota/english/
# 英语用户画像（自然语言段落；每 N 轮沉淀一次，显式偏好立刻更新）
# ENGLISH_PROFILE_AUTO_UPDATE=1
# ENGLISH_PROFILE_REFINE_EVERY_TURNS=3
# ENGLISH_PROFILE_UPDATE_COOLDOWN_SEC=20
# ENGLISH_PROFILE_LLM_MODEL=qwen-plus
# 英语对话历史（落库 + 重连注入上下文）
# ENGLISH_HISTORY_ENABLED=1
# ENGLISH_HISTORY_MAX_MESSAGES=20
# ENGLISH_HISTORY_MAX_CHARS=2500
# MYSQL_HOST=114.55.254.123
# MYSQL_PORT=3306
# MYSQL_USER=chenyujing
# MYSQL_PASSWORD=Centerm1@
# MYSQL_DATABASE=xiaozhi_server

